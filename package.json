{
  "name": "recipe-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "npm run build-storybook && npm run test:storybook:prepared",
    "test:storybook:prepared": "playwright test -c playwright.storybook.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:prepared": "playwright test",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
